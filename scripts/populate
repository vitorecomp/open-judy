#!/usr/bin/env python3
"""
Open Judy — Bulk Populate Script for Legal Cases (Processos) & Hearings (Audiências)

Usage:
  ./scripts/populate <base_folder> [--case-service-url URL] [--transcription-service-url URL] [--indexer-service-url URL] [--enqueue-transcription]

Expected structure inside <base_folder>:
  <base_folder>/
  ├── cases/ (or processos/, legal_cases/, legal-cases/, autos/)
  │   ├── *.json                  (Case JSON objects or arrays)
  │   ├── *.pdf | *.txt | *.md    (Standalone case files -> auto-creates case + document)
  │   └── <case_subfolder>/       (Folder per case with optional case.json/metadata.json + document files)
  └── audiencias/ (or hearings/, audiências/, sessoes/)
      ├── *.json                  (Hearing JSON objects or arrays)
      ├── *.mp4 | *.mp3 | *.wav | *.webm | *.m4a  (Audio/video recordings -> auto-registers hearing)
      └── <hearing_subfolder>/    (Folder per hearing with optional metadata.json + media/transcript files)
"""

import argparse
import hashlib
import json
import mimetypes
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

CNJ_REGEX = re.compile(r"\b\d{7}-\d{2}\.\d{4}\.\d\.\d{2}\.\d{4}\b")

CASE_DIR_CANDIDATES = [
    "cases",
    "legal_cases",
    "legal-cases",
    "processos",
    "processos_judiciais",
    "autos",
]

HEARING_DIR_CANDIDATES = [
    "audiencias",
    "audiências",
    "hearings",
    "sessoes",
    "sessões",
    "pautas",
]

MEDIA_EXTENSIONS = {".mp4", ".webm", ".mkv", ".mov", ".mp3", ".wav", ".m4a", ".ogg", ".flac"}
VIDEO_EXTENSIONS = {".mp4", ".webm", ".mkv", ".mov"}
DOC_EXTENSIONS = {".pdf", ".txt", ".md", ".doc", ".docx", ".rtf", ".html"}


def deterministic_uuid(seed: str) -> str:
    """Generate a deterministic UUIDv5-like string from a seed so re-runs are idempotent."""
    digest = hashlib.sha256(seed.encode("utf-8")).hexdigest()
    return f"{digest[0:8]}-{digest[8:12]}-4{digest[13:16]}-a{digest[17:20]}-{digest[20:32]}"


def http_request(url: str, method: str = "GET", payload: Optional[Dict[str, Any]] = None, timeout: int = 15) -> Tuple[int, Any]:
    headers = {
        "Accept": "application/json",
        "X-Dev-Mock-User": "admin.judy",
    }
    data = None
    if payload is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(payload).encode("utf-8")

    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8")
            if not raw.strip():
                return resp.status, None
            try:
                return resp.status, json.loads(raw)
            except json.JSONDecodeError:
                return resp.status, raw
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace") if e.fp else ""
        return e.code, raw
    except Exception as e:
        return 0, str(e)


def run_psql_sql(sql: str) -> bool:
    """Execute SQL inside open-judy-alloydb container if running, to ensure persistence in AlloyDB."""
    cmd = [
        "podman",
        "exec",
        "-i",
        "open-judy-alloydb",
        "psql",
        "-U",
        "judy_user",
        "-d",
        "open_judy_db",
        "-v",
        "ON_ERROR_STOP=0",
        "-q",
    ]
    try:
        res = subprocess.run(cmd, input=sql.encode("utf-8"), stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=15)
        return res.returncode == 0
    except Exception:
        return False


def sql_escape(val: Optional[str]) -> str:
    if val is None:
        return "NULL"
    escaped = str(val).replace("'", "''")
    return f"'{escaped}'"


def infer_document_type(filename: str) -> str:
    lower = filename.lower()
    if "inicial" in lower or "denuncia" in lower or "peticao" in lower:
        return "PETICAO_INICIAL"
    if "contestacao" in lower or "defesa" in lower:
        return "CONTESTACAO"
    if "laudo" in lower or "pericia" in lower or "parecer" in lower:
        return "LAUDO_TECNICO"
    if "procuracao" in lower or "substabelecimento" in lower:
        return "PROCURACAO"
    if "sentenca" in lower or "decisao" in lower or "acordao" in lower:
        return "SENTENCA"
    if "ata" in lower or "termo" in lower:
        return "ATA_AUDIENCIA"
    if "contrato" in lower or "distrato" in lower:
        return "CONTRATO"
    return "OUTROS"


def infer_hearing_type(text: str) -> str:
    lower = text.lower()
    if "conciliacao" in lower or "conciliação" in lower:
        return "CONCILIACAO"
    if "una" in lower or "trabalhista" in lower:
        return "UNA"
    if "custodia" in lower or "custódia" in lower:
        return "CUSTODIA"
    if "interrogatorio" in lower or "interrogatório" in lower:
        return "INTERROGATORIO"
    return "INSTRUCAO_E_JULGAMENTO"


def infer_legal_branch(text: str) -> str:
    lower = text.lower()
    if "trabalh" in lower or "trt" in lower or ".5." in lower:
        return "LABOR"
    if "crim" in lower or "penal" in lower or "custodia" in lower:
        return "CRIMINAL"
    if "famil" in lower or "sucess" in lower:
        return "FAMILY"
    if "fazend" in lower or "tribut" in lower or "fisc" in lower:
        return "TAX"
    return "CIVIL"


def extract_cnj_or_generate(text: str, index: int) -> str:
    match = CNJ_REGEX.search(text)
    if match:
        return match.group(0)
    digits = re.sub(r"\D", "", text)
    if len(digits) >= 7:
        seq = digits[:7]
    else:
        seq = f"{1000000 + index:07d}"
    return f"{seq}-88.2026.8.26.0100"


def find_subfolders(base_dir: Path) -> Tuple[Optional[Path], Optional[Path]]:
    """Locate the legal cases subfolder and audiencias subfolder inside base_dir."""
    subdirs = [d for d in sorted(base_dir.iterdir()) if d.is_dir() and not d.name.startswith(".")]

    cases_dir: Optional[Path] = None
    hearings_dir: Optional[Path] = None

    for d in subdirs:
        name_lower = d.name.lower()
        if name_lower in CASE_DIR_CANDIDATES or any(k in name_lower for k in ("case", "processo", "auto")):
            if cases_dir is None:
                cases_dir = d

    for d in subdirs:
        if d == cases_dir:
            continue
        name_lower = d.name.lower()
        if name_lower in HEARING_DIR_CANDIDATES or any(k in name_lower for k in ("audiencia", "audiência", "hearing", "sessao", "sessão")):
            if hearings_dir is None:
                hearings_dir = d

    # Fallback if user named the two subfolders something custom
    remaining = [d for d in subdirs if d not in (cases_dir, hearings_dir)]
    if cases_dir is None and remaining:
        cases_dir = remaining.pop(0)
    if hearings_dir is None and remaining:
        hearings_dir = remaining.pop(0)

    return cases_dir, hearings_dir


def parse_case_from_folder(folder: Path, idx: int) -> Dict[str, Any]:
    """Build a case payload from a subfolder containing optional metadata.json/case.json and documents."""
    meta_file = None
    for candidate in ("case.json", "metadata.json", "processo.json", f"{folder.name}.json"):
        p = folder / candidate
        if p.is_file():
            meta_file = p
            break

    case_data: Dict[str, Any] = {}
    if meta_file:
        try:
            case_data = json.loads(meta_file.read_text(encoding="utf-8"))
        except Exception as e:
            print(f"  [!] Warning: Failed to parse {meta_file}: {e}")

    case_number = case_data.get("caseNumber") or extract_cnj_or_generate(folder.name, idx)
    case_id = case_data.get("id") or deterministic_uuid(f"case:{case_number}")
    subject = case_data.get("subject") or folder.name.replace("_", " ").replace("-", " ").title()
    legal_branch = case_data.get("legalBranch") or infer_legal_branch(f"{folder.name} {case_number} {subject}")

    docs: List[Dict[str, Any]] = list(case_data.get("documents") or [])
    existing_filenames = {d.get("fileName") for d in docs if d.get("fileName")}

    for item in sorted(folder.iterdir()):
        if item.is_file() and item.suffix.lower() in DOC_EXTENSIONS and item.name not in existing_filenames:
            mime_type, _ = mimetypes.guess_type(item.name)
            extracted_text = None
            if item.suffix.lower() in {".txt", ".md"}:
                try:
                    extracted_text = item.read_text(encoding="utf-8", errors="replace")[:50000]
                except Exception:
                    pass
            docs.append({
                "id": deterministic_uuid(f"doc:{case_number}:{item.name}"),
                "title": item.stem.replace("_", " ").replace("-", " ").title(),
                "documentType": infer_document_type(item.name),
                "fileName": item.name,
                "fileSize": item.stat().st_size,
                "mimeType": mime_type or "application/pdf",
                "storageUri": f"s3://open-judy-docs/{case_number}/{item.name}",
                "pageCount": max(1, item.stat().st_size // 3000),
                "ocrStatus": "COMPLETED",
                "extractedText": extracted_text,
                "uploadedBy": case_data.get("uploadedBy", "Script Populate Open Judy"),
                "_localPath": str(item),
            })

    return {
        "id": case_id,
        "caseNumber": case_number,
        "courtJurisdiction": case_data.get("courtJurisdiction") or "3ª Vara Cível Central da Comarca de São Paulo/SP",
        "legalBranch": legal_branch,
        "subject": subject,
        "plaintiffName": case_data.get("plaintiffName") or "Parte Autora Cadastrada via Populate",
        "defendantName": case_data.get("defendantName") or "Parte Ré Cadastrada via Populate",
        "judgeName": case_data.get("judgeName") or "Dra. Camila Vasconcelos",
        "prosecutorName": case_data.get("prosecutorName"),
        "status": case_data.get("status") or "EM_ANDAMENTO",
        "documents": docs,
    }


def collect_cases(cases_dir: Path) -> List[Dict[str, Any]]:
    cases: List[Dict[str, Any]] = []
    if not cases_dir or not cases_dir.exists():
        return cases

    idx = 1
    for entry in sorted(cases_dir.iterdir()):
        if entry.name.startswith("."):
            continue

        if entry.is_dir():
            cases.append(parse_case_from_folder(entry, idx))
            idx += 1
        elif entry.is_file() and entry.suffix.lower() == ".json":
            try:
                raw = json.loads(entry.read_text(encoding="utf-8"))
                items = raw if isinstance(raw, list) else raw.get("cases", [raw])
                for item in items:
                    c_num = item.get("caseNumber") or extract_cnj_or_generate(entry.stem, idx)
                    item["caseNumber"] = c_num
                    item["id"] = item.get("id") or deterministic_uuid(f"case:{c_num}")
                    item.setdefault("courtJurisdiction", "3ª Vara Cível Central da Comarca de São Paulo/SP")
                    item.setdefault("legalBranch", infer_legal_branch(f"{c_num} {item.get('subject', '')}"))
                    item.setdefault("subject", "Procedimento Judicial Cadastrado")
                    item.setdefault("plaintiffName", "Autor Judicial")
                    item.setdefault("defendantName", "Réu Judicial")
                    item.setdefault("judgeName", "Dra. Camila Vasconcelos")
                    item.setdefault("status", "EM_ANDAMENTO")
                    item.setdefault("documents", [])
                    cases.append(item)
                    idx += 1
            except Exception as e:
                print(f"  [!] Failed to load JSON case file {entry}: {e}")
        elif entry.is_file() and entry.suffix.lower() in DOC_EXTENSIONS:
            c_num = extract_cnj_or_generate(entry.stem, idx)
            c_id = deterministic_uuid(f"case:{c_num}")
            mime_type, _ = mimetypes.guess_type(entry.name)
            extracted_text = None
            if entry.suffix.lower() in {".txt", ".md"}:
                try:
                    extracted_text = entry.read_text(encoding="utf-8", errors="replace")[:50000]
                except Exception:
                    pass
            cases.append({
                "id": c_id,
                "caseNumber": c_num,
                "courtJurisdiction": "3ª Vara Cível Central da Comarca de São Paulo/SP",
                "legalBranch": infer_legal_branch(entry.stem),
                "subject": entry.stem.replace("_", " ").replace("-", " ").title(),
                "plaintiffName": "Parte Autora Cadastrada",
                "defendantName": "Parte Ré Cadastrada",
                "judgeName": "Dra. Camila Vasconcelos",
                "status": "EM_ANDAMENTO",
                "documents": [
                    {
                        "id": deterministic_uuid(f"doc:{c_num}:{entry.name}"),
                        "title": entry.stem.replace("_", " ").replace("-", " ").title(),
                        "documentType": infer_document_type(entry.name),
                        "fileName": entry.name,
                        "fileSize": entry.stat().st_size,
                        "mimeType": mime_type or "application/pdf",
                        "storageUri": f"s3://open-judy-docs/{c_num}/{entry.name}",
                        "pageCount": max(1, entry.stat().st_size // 3000),
                        "ocrStatus": "COMPLETED",
                        "extractedText": extracted_text,
                        "uploadedBy": "Script Populate Open Judy",
                        "_localPath": str(entry),
                    }
                ],
            })
            idx += 1

    return cases


def collect_hearings(hearings_dir: Path, known_cases: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    hearings: List[Dict[str, Any]] = []
    if not hearings_dir or not hearings_dir.exists():
        return hearings

    case_by_number = {c["caseNumber"]: c for c in known_cases}
    default_case = known_cases[0] if known_cases else None

    idx = 1
    for entry in sorted(hearings_dir.iterdir()):
        if entry.name.startswith("."):
            continue

        if entry.is_dir():
            meta_file = None
            for candidate in ("hearing.json", "audiencia.json", "metadata.json", f"{entry.name}.json"):
                p = entry / candidate
                if p.is_file():
                    meta_file = p
                    break
            h_data: Dict[str, Any] = {}
            if meta_file:
                try:
                    h_data = json.loads(meta_file.read_text(encoding="utf-8"))
                except Exception as e:
                    print(f"  [!] Warning: Failed to parse {meta_file}: {e}")

            media_file: Optional[Path] = None
            for item in sorted(entry.iterdir()):
                if item.is_file() and item.suffix.lower() in MEDIA_EXTENSIONS:
                    media_file = item
                    break

            c_num = h_data.get("caseNumber") or extract_cnj_or_generate(entry.name, idx)
            matched_case = case_by_number.get(c_num) or default_case
            if matched_case and not CNJ_REGEX.search(entry.name) and not h_data.get("caseNumber"):
                c_num = matched_case["caseNumber"]

            case_id = h_data.get("caseId") or (matched_case["id"] if matched_case else deterministic_uuid(f"case:{c_num}"))
            media_filename = h_data.get("mediaFilename") or (media_file.name if media_file else f"{entry.name}.mp4")
            media_ext = Path(media_filename).suffix.lower()
            media_type = h_data.get("mediaType") or ("VIDEO" if media_ext in VIDEO_EXTENSIONS else "AUDIO")
            hearing_id = h_data.get("id") or deterministic_uuid(f"hearing:{c_num}:{media_filename}")

            hearings.append({
                "id": hearing_id,
                "caseId": case_id,
                "caseNumber": c_num,
                "courtJurisdiction": h_data.get("courtJurisdiction")
                or (matched_case.get("courtJurisdiction") if matched_case else "3ª Vara Cível Central da Comarca de São Paulo/SP"),
                "hearingType": h_data.get("hearingType") or infer_hearing_type(f"{entry.name} {media_filename}"),
                "scheduledDateTime": h_data.get("scheduledDateTime") or datetime.now(timezone.utc).isoformat(),
                "status": h_data.get("status") or "READY",
                "mediaType": media_type,
                "mediaFilename": media_filename,
                "audioDurationSeconds": h_data.get("audioDurationSeconds") or 180.0,
                "audioSizeBytes": media_file.stat().st_size if media_file else h_data.get("audioSizeBytes", 25000000),
                "participants": h_data.get("participants") or [],
                "segments": h_data.get("segments") or [],
                "_localMediaPath": str(media_file) if media_file else None,
            })
            idx += 1

        elif entry.is_file() and entry.suffix.lower() == ".json":
            try:
                raw = json.loads(entry.read_text(encoding="utf-8"))
                items = raw if isinstance(raw, list) else raw.get("hearings", raw.get("audiencias", [raw]))
                for item in items:
                    c_num = item.get("caseNumber") or (default_case["caseNumber"] if default_case else extract_cnj_or_generate(entry.stem, idx))
                    matched_case = case_by_number.get(c_num) or default_case
                    c_id = item.get("caseId") or (matched_case["id"] if matched_case else deterministic_uuid(f"case:{c_num}"))
                    media_filename = item.get("mediaFilename") or item.get("audioFilename") or f"{entry.stem}_{idx}.mp4"
                    h_id = item.get("id") or deterministic_uuid(f"hearing:{c_num}:{media_filename}")
                    media_ext = Path(media_filename).suffix.lower()
                    local_media = hearings_dir / media_filename

                    hearings.append({
                        "id": h_id,
                        "caseId": c_id,
                        "caseNumber": c_num,
                        "courtJurisdiction": item.get("courtJurisdiction")
                        or (matched_case.get("courtJurisdiction") if matched_case else "3ª Vara Cível Central da Comarca de São Paulo/SP"),
                        "hearingType": item.get("hearingType") or infer_hearing_type(media_filename),
                        "scheduledDateTime": item.get("scheduledDateTime") or datetime.now(timezone.utc).isoformat(),
                        "status": item.get("status") or "READY",
                        "mediaType": item.get("mediaType") or ("VIDEO" if media_ext in VIDEO_EXTENSIONS else "AUDIO"),
                        "mediaFilename": media_filename,
                        "audioDurationSeconds": item.get("audioDurationSeconds") or 180.0,
                        "audioSizeBytes": local_media.stat().st_size if local_media.is_file() else item.get("audioSizeBytes", 25000000),
                        "participants": item.get("participants") or [],
                        "segments": item.get("segments") or [],
                        "_localMediaPath": str(local_media) if local_media.is_file() else None,
                    })
                    idx += 1
            except Exception as e:
                print(f"  [!] Failed to load JSON hearing file {entry}: {e}")

        elif entry.is_file() and entry.suffix.lower() in MEDIA_EXTENSIONS:
            # Skip if this media file was already referenced by a JSON file
            if any(h.get("mediaFilename") == entry.name for h in hearings):
                continue
            matched_case = None
            cnj_match = CNJ_REGEX.search(entry.stem)
            if cnj_match and cnj_match.group(0) in case_by_number:
                matched_case = case_by_number[cnj_match.group(0)]
            else:
                # Match by partial digits in case number
                stem_digits = re.sub(r"\D", "", entry.stem)
                if len(stem_digits) >= 4:
                    for c_num_key, c_obj in case_by_number.items():
                        if stem_digits in re.sub(r"\D", "", c_num_key):
                            matched_case = c_obj
                            break
            if not matched_case and known_cases:
                matched_case = known_cases[(idx - 1) % len(known_cases)]

            c_num = matched_case["caseNumber"] if matched_case else extract_cnj_or_generate(entry.stem, idx)
            c_id = matched_case["id"] if matched_case else deterministic_uuid(f"case:{c_num}")
            h_id = deterministic_uuid(f"hearing:{c_num}:{entry.name}")
            media_type = "VIDEO" if entry.suffix.lower() in VIDEO_EXTENSIONS else "AUDIO"

            hearings.append({
                "id": h_id,
                "caseId": c_id,
                "caseNumber": c_num,
                "courtJurisdiction": matched_case.get("courtJurisdiction") if matched_case else "3ª Vara Cível Central da Comarca de São Paulo/SP",
                "hearingType": infer_hearing_type(entry.stem),
                "scheduledDateTime": datetime.now(timezone.utc).isoformat(),
                "status": "READY",
                "mediaType": media_type,
                "mediaFilename": entry.name,
                "audioDurationSeconds": 180.0,
                "audioSizeBytes": entry.stat().st_size,
                "participants": [],
                "segments": [],
                "_localMediaPath": str(entry),
            })
            idx += 1

    return hearings


def persist_case_to_db(case_obj: Dict[str, Any]) -> None:
    sql_lines = [
        f"""
        INSERT INTO tb_cases (
            id, case_number, court_jurisdiction, legal_branch, subject,
            plaintiff_name, defendant_name, judge_name, prosecutor_name, status
        ) VALUES (
            {sql_escape(case_obj['id'])},
            {sql_escape(case_obj['caseNumber'])},
            {sql_escape(case_obj['courtJurisdiction'])},
            {sql_escape(case_obj['legalBranch'])},
            {sql_escape(case_obj.get('subject'))},
            {sql_escape(case_obj.get('plaintiffName'))},
            {sql_escape(case_obj.get('defendantName'))},
            {sql_escape(case_obj.get('judgeName'))},
            {sql_escape(case_obj.get('prosecutorName'))},
            {sql_escape(case_obj.get('status', 'EM_ANDAMENTO'))}
        )
        ON CONFLICT (case_number) DO UPDATE SET
            court_jurisdiction = EXCLUDED.court_jurisdiction,
            legal_branch = EXCLUDED.legal_branch,
            subject = EXCLUDED.subject,
            plaintiff_name = EXCLUDED.plaintiff_name,
            defendant_name = EXCLUDED.defendant_name,
            judge_name = EXCLUDED.judge_name,
            status = EXCLUDED.status,
            updated_at = NOW();
        """
    ]

    for doc in case_obj.get("documents", []):
        doc_id = doc.get("id") or deterministic_uuid(f"doc:{case_obj['caseNumber']}:{doc.get('fileName', 'doc')}")
        sql_lines.append(
            f"""
            INSERT INTO tb_case_documents (
                id, case_id, title, document_type, file_name, file_size,
                mime_type, storage_uri, page_count, ocr_status, extracted_text, uploaded_by
            ) VALUES (
                {sql_escape(doc_id)},
                (SELECT id FROM tb_cases WHERE case_number = {sql_escape(case_obj['caseNumber'])} LIMIT 1),
                {sql_escape(doc.get('title', 'Documento Judicial'))},
                {sql_escape(doc.get('documentType', 'OUTROS'))},
                {sql_escape(doc.get('fileName'))},
                {int(doc.get('fileSize') or 0)},
                {sql_escape(doc.get('mimeType', 'application/pdf'))},
                {sql_escape(doc.get('storageUri'))},
                {int(doc.get('pageCount') or 1)},
                {sql_escape(doc.get('ocrStatus', 'COMPLETED'))},
                {sql_escape(doc.get('extractedText'))},
                {sql_escape(doc.get('uploadedBy', 'Script Populate'))}
            )
            ON CONFLICT (id) DO UPDATE SET
                title = EXCLUDED.title,
                document_type = EXCLUDED.document_type,
                file_size = EXCLUDED.file_size,
                extracted_text = COALESCE(EXCLUDED.extracted_text, tb_case_documents.extracted_text),
                updated_at = NOW();
            """
        )

    run_psql_sql("\n".join(sql_lines))


def persist_hearing_to_db(hearing_obj: Dict[str, Any]) -> None:
    sql_lines = [
        f"""
        INSERT INTO tb_cases (id, case_number, court_jurisdiction, legal_branch, subject, status)
        VALUES (
            {sql_escape(hearing_obj['caseId'])},
            {sql_escape(hearing_obj['caseNumber'])},
            {sql_escape(hearing_obj['courtJurisdiction'])},
            'CIVIL',
            'Processo Judicial Vinculado à Audiência',
            'EM_ANDAMENTO'
        )
        ON CONFLICT (case_number) DO NOTHING;

        INSERT INTO tb_hearings (
            id, case_id, hearing_type, status, media_type,
            audio_filename, audio_duration_seconds, audio_size_bytes,
            media_filename, media_duration_seconds, media_size_bytes
        ) VALUES (
            {sql_escape(hearing_obj['id'])},
            (SELECT id FROM tb_cases WHERE case_number = {sql_escape(hearing_obj['caseNumber'])} LIMIT 1),
            {sql_escape(hearing_obj['hearingType'])},
            {sql_escape(hearing_obj.get('status', 'READY'))},
            {sql_escape(hearing_obj['mediaType'])},
            {sql_escape(hearing_obj['mediaFilename'])},
            {float(hearing_obj.get('audioDurationSeconds') or 180.0)},
            {int(hearing_obj.get('audioSizeBytes') or 0)},
            {sql_escape(hearing_obj['mediaFilename'])},
            {float(hearing_obj.get('audioDurationSeconds') or 180.0)},
            {int(hearing_obj.get('audioSizeBytes') or 0)}
        )
        ON CONFLICT (id) DO UPDATE SET
            hearing_type = EXCLUDED.hearing_type,
            status = EXCLUDED.status,
            media_type = EXCLUDED.media_type,
            media_filename = EXCLUDED.media_filename,
            updated_at = NOW();
        """
    ]

    segments = hearing_obj.get("segments") or []
    if segments:
        transcript_id = deterministic_uuid(f"transcript:{hearing_obj['id']}")
        block_id = deterministic_uuid(f"block:{hearing_obj['id']}:1")
        sql_lines.append(
            f"""
            INSERT INTO tb_transcripts (id, hearing_id, detected_language, total_segments, average_confidence, engine_used)
            VALUES ({sql_escape(transcript_id)}, {sql_escape(hearing_obj['id'])}, 'pt-BR', {len(segments)}, 0.98, 'GEMINI-2.0-FLASH')
            ON CONFLICT (hearing_id) DO UPDATE SET total_segments = EXCLUDED.total_segments, updated_at = NOW();

            INSERT INTO tb_transcript_blocks (
                id, hearing_id, block_index, title, start_time_ms, end_time_ms,
                start_time_formatted, end_time_formatted, estimated_tokens, segment_count, summary
            ) VALUES (
                {sql_escape(block_id)}, {sql_escape(hearing_obj['id'])}, 1,
                'Bloco 1: Instrução e Depoimentos da Audiência',
                0, {int(segments[-1].get('endTimeMs', 120000))},
                '00:00', '02:00', 128000, {len(segments)},
                'Transcrição importada pelo utilitário de população do Open Judy.'
            )
            ON CONFLICT (hearing_id, block_index) DO UPDATE SET segment_count = EXCLUDED.segment_count;
            """
        )
        for i, seg in enumerate(segments, start=1):
            seg_id = seg.get("id") or deterministic_uuid(f"seg:{hearing_obj['id']}:{i}")
            sql_lines.append(
                f"""
                INSERT INTO tb_transcript_segments (
                    id, transcript_id, segment_index, start_time_ms, end_time_ms,
                    speaker_role, speaker_name, text, confidence_score, is_key_statement, topic_tag, block_id, block_index
                ) VALUES (
                    {sql_escape(seg_id)},
                    (SELECT id FROM tb_transcripts WHERE hearing_id = {sql_escape(hearing_obj['id'])} LIMIT 1),
                    {int(seg.get('segmentIndex', i))},
                    {int(seg.get('startTimeMs', (i - 1) * 15000))},
                    {int(seg.get('endTimeMs', i * 15000))},
                    {sql_escape(seg.get('speakerRole', 'MAGISTRADO'))},
                    {sql_escape(seg.get('speakerName', 'Participante'))},
                    {sql_escape(seg.get('text', ''))},
                    {float(seg.get('confidenceScore', 0.98))},
                    {'TRUE' if seg.get('isKeyStatement') else 'FALSE'},
                    {sql_escape(seg.get('topicTag', 'Audiência'))},
                    {sql_escape(block_id)},
                    1
                )
                ON CONFLICT (id) DO NOTHING;
                """
            )

    run_psql_sql("\n".join(sql_lines))


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Populate Open Judy with Legal Cases (Processos) and Hearings (Audiências) from a base directory."
    )
    parser.add_argument(
        "base_folder",
        help="Path to the base folder containing two subfolders: one for legal cases and another for audiencias.",
    )
    parser.add_argument(
        "--case-service-url",
        default=os.environ.get("CASE_SERVICE_URL", "http://localhost:8081"),
        help="Base URL of case-service (default: http://localhost:8081)",
    )
    parser.add_argument(
        "--transcription-service-url",
        default=os.environ.get("TRANSCRIPTION_SERVICE_URL", "http://localhost:8083"),
        help="Base URL of transcription-service (default: http://localhost:8083)",
    )
    parser.add_argument(
        "--indexer-service-url",
        default=os.environ.get("INDEXER_SERVICE_URL", "http://localhost:8089"),
        help="Base URL of indexer-service (default: http://localhost:8089)",
    )
    parser.add_argument(
        "--enqueue-transcription",
        action="store_true",
        help="Also enqueue RabbitMQ transcription jobs for populated audiencias.",
    )

    args = parser.parse_args()
    base_dir = Path(args.base_folder).expanduser().resolve()

    if not base_dir.exists() or not base_dir.is_dir():
        print(f"[ERROR] Base folder does not exist or is not a directory: {base_dir}", file=sys.stderr)
        return 1

    repo_root = Path(__file__).resolve().parent.parent
    repo_data_cases = repo_root / "data" / "cases"
    repo_data_hearings = repo_root / "data" / "hearings"
    repo_data_cases.mkdir(parents=True, exist_ok=True)
    repo_data_hearings.mkdir(parents=True, exist_ok=True)

    cases_dir, hearings_dir = find_subfolders(base_dir)

    print("========================================================================")
    print(" Open Judy — Populate Legal Cases & Audiências")
    print("========================================================================")
    print(f" Base Folder      : {base_dir}")
    print(f" Cases Subfolder  : {cases_dir if cases_dir else 'Not found'}")
    print(f" Hearings Subfolder: {hearings_dir if hearings_dir else 'Not found'}")
    print("------------------------------------------------------------------------")

    if not cases_dir and not hearings_dir:
        print(
            f"[ERROR] Could not find the two subfolders inside {base_dir}. "
            "Expected one subfolder for legal cases (e.g. 'cases' or 'processos') and one for hearings (e.g. 'audiencias' or 'hearings').",
            file=sys.stderr,
        )
        return 1

    # 1. Collect & Populate Legal Cases
    cases = collect_cases(cases_dir) if cases_dir else []
    print(f"\n[1/3] Populating Legal Cases ({len(cases)} found)...")
    populated_cases = 0

    for c in cases:
        local_docs = c.get("documents", [])
        clean_docs = []
        for d in local_docs:
            local_path = d.pop("_localPath", None)
            if local_path:
                src = Path(local_path)
                dst_dir = repo_data_cases / c["caseNumber"]
                dst_dir.mkdir(parents=True, exist_ok=True)
                dst = dst_dir / src.name
                if src.resolve() != dst.resolve():
                    shutil.copy2(src, dst)
            clean_docs.append(d)
        c["documents"] = clean_docs

        status_code, resp = http_request(f"{args.case_service_url}/api/v1/cases", method="POST", payload=c)
        persist_case_to_db(c)

        if status_code in (200, 201):
            print(f"  [+] Case {c['caseNumber']} ({c['legalBranch']}) -> {c['subject']} [{len(clean_docs)} doc(s)]")
            populated_cases += 1
        else:
            print(f"  [~] Case {c['caseNumber']} persisted to DB (case-service HTTP {status_code})")
            populated_cases += 1

    # 2. Collect & Populate Hearings (Audiências)
    hearings = collect_hearings(hearings_dir, cases) if hearings_dir else []
    print(f"\n[2/3] Populating Audiências / Hearings ({len(hearings)} found)...")
    populated_hearings = 0

    for h in hearings:
        local_media = h.pop("_localMediaPath", None)
        if local_media:
            src = Path(local_media)
            dst = repo_data_hearings / src.name
            if src.resolve() != dst.resolve():
                shutil.copy2(src, dst)

        status_code, resp = http_request(f"{args.case_service_url}/api/v1/hearings", method="POST", payload=h)
        persist_hearing_to_db(h)

        if status_code in (200, 201):
            print(f"  [+] Audiência [{h['hearingType']}] Processo {h['caseNumber']} ({h['mediaFilename']})")
            populated_hearings += 1
        else:
            print(f"  [~] Audiência [{h['hearingType']}] Processo {h['caseNumber']} persisted to DB (HTTP {status_code})")
            populated_hearings += 1

        if args.enqueue_transcription:
            params = urllib.parse.urlencode({
                "caseNumber": h["caseNumber"],
                "mediaType": h["mediaType"],
                "filename": h["mediaFilename"],
            })
            enq_code, _ = http_request(
                f"{args.transcription_service_url}/api/v1/transcriptions/enqueue/{h['id']}?{params}",
                method="POST",
            )
            print(f"      -> Enqueued transcription job for {h['id']} (HTTP {enq_code})")

    # 3. Trigger Unified Elasticsearch Reindexing
    print("\n[3/3] Synchronizing Unified Search Index (Elasticsearch)...")
    idx_code, idx_resp = http_request(f"{args.indexer_service_url}/api/v1/indexer/reindex", method="POST")
    if idx_code in (200, 201, 202):
        print("  [+] Elasticsearch reindex completed successfully.")
    else:
        print(f"  [i] Elasticsearch reindex skipped or unavailable (HTTP {idx_code}).")

    print("\n========================================================================")
    print(f" Done! Populated {populated_cases} Legal Case(s) and {populated_hearings} Audiência(s).")
    print("========================================================================")
    return 0


if __name__ == "__main__":
    sys.exit(main())
